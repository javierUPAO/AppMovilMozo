<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#1A1A2E">

    <!-- Logo circular con iniciales -->
    <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:background="@drawable/bg_circle_orange"
            android:layout_marginBottom="16dp">
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DB"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"/>
    </LinearLayout>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doña Bere"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Elige cómo deseas ingresar"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="48dp"/>

    <!-- Botón credenciales -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginCredentials"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Ingresar con credenciales"
            android:textSize="15sp"
            android:textColor="#1A1A2E"
            android:backgroundTint="#F59E0B"
            app:icon="@drawable/ic_mail"
            app:iconTint="#1A1A2E"
            app:iconGravity="textStart"
            app:cornerRadius="10dp"
            android:layout_marginBottom="12dp"/>

    <!-- Separador -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
        <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#333333"/>
        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="o"
                android:textSize="12sp"
                android:textColor="#555555"
                android:layout_marginHorizontal="10dp"/>
        <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#333333"/>
    </LinearLayout>

    <!-- Botón huella -->
    <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLoginBiometric"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Ingresar con huella dactilar"
            android:textSize="15sp"
            android:textColor="#16A34A"
            android:backgroundTint="#252540"
            app:icon="@drawable/ic_fingerprint"
            app:iconTint="#16A34A"
            app:iconGravity="textStart"
            app:strokeColor="#16A34A"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"/>

</LinearLayout>