<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FBBF24"
    app:cardBackgroundColor="#FFFBEB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:orientation="vertical"
        android:padding="10dp">

        <!-- Header cuenta -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_nombre_cuenta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cuenta 1"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_eliminar_cuenta"
                android:layout_width="42dp"
                android:layout_height="38dp"
                android:textSize="16sp"
                android:textAllCaps="false"
                android:textColor="#EF4444"
                android:src="@drawable/ic_delete"
                app:tint="@color/primary_color"
                android:backgroundTint="#FFFFFF" />

        </LinearLayout>

        <!-- Lista de detalles asignados a esta cuenta -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detalle_cuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tv_total_cuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TOTAL : S/. 0.00"
            android:textColor="#000000"
            android:textStyle="bold"
            android:textSize="13sp"
            android:gravity="end"
            android:layout_marginTop="10dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>