<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout para CrearPedidoActivity (HU 3.3)
    Estructura:
     ┌─────────────────────────────┐
     │  Toolbar (Mesa X / Mesas X+Y)│
     ├─────────────────────────────┤
     │  RecyclerView (detalles)    │
     │  (o TextView "vacío")       │
     ├─────────────────────────────┤
     │  Total: S/ XX.XX            │
     │  [Agregar producto] [Enviar]│
     └─────────────────────────────┘
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_color">

    <!-- AppBar -->
    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:title="Nuevo Pedido"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:titleTextColor="@color/white" />

    </com.google.android.material.appbar.AppBarLayout>

    <!-- Contenido principal -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

            <!-- Label de la(s) mesa(s) -->
            <TextView
                    android:id="@+id/tv_mesas_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mesa --"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#E5A735"
                    android:layout_marginBottom="12dp" />

            <!-- ProgressBar (loading) -->
            <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp" />

            <!-- Estado vacío -->
            <TextView
                    android:id="@+id/tv_pedido_vacio"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:gravity="center"
                    android:text="🍽️\nAún no hay productos en el pedido.\nPresiona 'Agregar producto' para comenzar."
                    android:textSize="16sp"
                    android:textColor="@color/text_secondary"
                    android:visibility="visible" />

            <!-- Lista de detalles del pedido -->
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_detalles_pedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone" />

            <!-- Separador -->
            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/divider_color"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

            <!-- Total -->
            <TextView
                    android:id="@+id/tv_total_pedido"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Total: S/ 0.00"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:gravity="end"
                    android:layout_marginBottom="16dp" />

            <!-- Botones de acción -->
            <!-- Touch targets mínimo 48dp de altura (RNF Accesibilidad) -->

            <!-- Agregar producto -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_agregar_producto"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="+ Agregar producto"
                    android:textSize="16sp"
                    app:strokeColor="#E5B035"
                    app:strokeWidth="2dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_marginBottom="12dp" />

            <!-- Confirmar y enviar a cocina -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_confirmar_pedido"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Enviar a cocina"
                    android:textSize="16sp"
                    android:enabled="false"
                    android:layout_marginBottom="24dp"
                    app:backgroundTint="#E5AD35" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
