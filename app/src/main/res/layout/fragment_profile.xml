<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Card: Información de Usuario -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white">

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi Perfil"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📧"
                        android:textSize="18sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="usuario@example.com"
                        android:textSize="14sp"
                        android:textColor="#666666" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Card: Seguridad - Huella Dactilar -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@android:color/white">

                <!-- Encabezado de Seguridad -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/ivFingerprintIcon"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🔐"
                        android:textSize="24sp"
                        android:gravity="center"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🔐 SEGURIDAD"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1A1A2E" />
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#EEEEEE"
                    android:layout_marginBottom="16dp" />

                <!-- Estado de Huella -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvFingerprintStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚠️ No Registrada"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#E94560"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tvFingerprintDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registra tu huella para entradas más rápidas"
                        android:textSize="13sp"
                        android:textColor="#999999" />
                </LinearLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btnRegisterFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="📝 Registrar Mi Huella"
                        android:textSize="14sp"
                        android:backgroundTint="#16A34A"
                        android:layout_marginBottom="8dp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btnDeleteFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="🗑️ Eliminar Huella"
                        android:textSize="14sp"
                        android:backgroundTint="#E94560"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginVertical="16dp" />

        <!-- Mensajes de Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Error"
            android:textColor="#E94560"
            android:textSize="14sp"
            android:background="#FFE5E5"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Mensajes de Éxito -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Éxito"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:background="#E5F5E5"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
