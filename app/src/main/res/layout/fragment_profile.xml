<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Card: Información de Usuario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            app:strokeWidth="2dp"
            app:strokeColor="#F59E0B"
            app:cardBackgroundColor="#FFFBEB"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"

                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="90dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_circle_orange"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/profileLetter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DB"
                        android:textColor="#F59E0B"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvUserName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:textColor="#1A1A2E"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_marginBottom="25dp">

                    <TextView
                        android:id="@+id/tvUserEmail"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="usuario@example.com"
                        android:textColor="#666666"
                        android:textSize="14sp" />
                </LinearLayout>
                <androidx.fragment.app.FragmentContainerView
                    android:id="@+id/turnoFragmentContainer"
                    android:name="com.donabere.amm.ui.fragment.TurnoFragment"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card: Opciones -->
        <com.google.android.material.card.MaterialCardView
            app:strokeWidth="2dp"
            app:strokeColor="#F59E0B"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#FFFBEB"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_notifications"
                        app:tint="#F59E0B" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Notificaciones" android:textColor="#000000" android:textSize="16sp"/>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:thumbTint="#F59E0B"/>
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FDE68A"/>

                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_help" app:tint="#F59E0B"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Ayuda y Soporte" android:textColor="#000000" android:textSize="16sp"/>
                    <ImageButton android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_chevron_right" app:tint="#F59E0B"
                        android:background="@android:color/transparent"
                        />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#FDE68A"/>

                <LinearLayout
                    android:id="@+id/btnLogout"
                    android:layout_width="300dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_logout"
                        android:rotation="90"
                        app:tint="#EF4444" />
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Cerrar Sesión" android:textColor="#EF4444" android:textSize="16sp"/>
                    <ImageView
                        android:layout_width="24dp"
                        android:background="@android:color/transparent"
                        android:layout_height="24dp" android:src="@drawable/ic_chevron_right"
                        app:tint="#F59E0B"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Card: Seguridad - Huella Dactilar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            app:strokeWidth="2dp"
            app:strokeColor="#F59E0B"
            app:cardBackgroundColor="#FFFBEB"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
>

                <!-- Encabezado de Seguridad -->
                <LinearLayout
                    android:layout_width="300dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">
                    <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_lock" app:tint="#F59E0B"/>
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:text="Seguridad" android:textStyle="bold" android:textColor="#000000" android:textSize="16sp"/>
                    <ImageButton
                        android:background="@android:color/transparent"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:rotation="90"
                        app:tint="#F59E0B"/>
                </LinearLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:background="#FDE68A"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp" />

                <!-- Estado de Huella -->
                <LinearLayout
                    android:layout_width="250dp"
                    android:layout_gravity="center"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_warning"
                            android:layout_marginEnd="10dp"
                            app:tint="#E94560"/>

                        <TextView
                            android:id="@+id/tvFingerprintStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Registrada"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#E94560"
                            android:layout_marginBottom="8dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFingerprintDescription"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registra tu huella para entradas más rápidas"
                        android:textSize="13sp"
                        android:textColor="#000000" />

                </LinearLayout>

                <!-- Botones -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:id="@+id/btnRegisterFingerprint"
                        android:layout_height="48dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="16dp"
                        android:backgroundTint="#F59E0B"
                        android:text="Registrar huella"
                        android:textSize="14sp"
                        android:textAllCaps="false"
                        android:textColor="#000000"
                        app:cornerRadius="20dp"
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        app:icon="@drawable/ic_alternative_fingerprint"
                        app:iconTint="#000000" />

                    <Button
                        android:id="@+id/btnDeleteFingerprint"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="Eliminar Huella"
                        android:textSize="14sp"
                        android:backgroundTint="#E94560"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginVertical="16dp" />

        <!-- Mensajes de Error -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Error"
            android:textColor="#E94560"
            android:textSize="14sp"
            android:background="#FFE5E5"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

        <!-- Mensajes de Éxito -->
        <TextView
            android:id="@+id/tvSuccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Éxito"
            android:textColor="#16A34A"
            android:textSize="14sp"
            android:background="#E5F5E5"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
