<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="10dp"
    android:background="#FDE68A"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ================= HEADER (CLICK) ================= -->
        <LinearLayout
            android:id="@+id/headerCuenta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:id="@+id/tvCuentaId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cuenta #1"
                android:textStyle="bold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvEstadoCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDIENTE"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/tvTotalCuenta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Total: S/ 45.00"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />

        </LinearLayout>

        <!-- ================= DETAIL (EXPANDIBLE) ================= -->
        <LinearLayout
            android:id="@+id/detailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="10dp">

            <!-- separador -->
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#FDE68A"
                android:layout_marginBottom="8dp"/>

            <!-- lista productos -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetalleCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                />

            <!-- botón pagar -->
            <Button
                android:id="@+id/btnPagarCuenta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Marcar como pagado"
                android:backgroundTint="#F59E0B"
                android:textColor="@android:color/white"
                android:layout_marginTop="12dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>