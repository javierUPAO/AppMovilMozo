<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FBBF24"
    app:cardBackgroundColor="#FFFBEB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header desplegable -->
        <LinearLayout
            android:id="@+id/header_cuenta_resumen"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <TextView
                android:id="@+id/tv_icono_persona"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="👤"
                android:textSize="22sp"
                android:background="#2563EB"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_nombre_cuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Persona 1"
                    android:textColor="#000000"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tv_total_cuenta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="S/. 0.00"
                    android:textColor="#000000"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_flecha"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="⌄"
                android:textColor="#F59E0B"
                android:textSize="28sp" />

        </LinearLayout>

        <!-- Contenido desplegable -->
        <LinearLayout
            android:id="@+id/contenido_cuenta_resumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_detalles_resumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

            <TextView
                android:id="@+id/tv_total_cuenta_cuerpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total cuenta: S/. 0.00"
                android:textColor="#000000"
                android:textStyle="bold"
                android:textSize="13sp"
                android:gravity="end"
                android:layout_marginTop="8dp"
                android:paddingEnd="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>