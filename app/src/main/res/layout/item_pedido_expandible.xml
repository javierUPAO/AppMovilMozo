<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header del pedido (expandible) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <!-- Primera línea: ORD - número de pedido | ESTADO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvPedidoId"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ORD - #12345"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/tvEstado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENVIADO"
                    android:textSize="10sp" />

            </LinearLayout>

            <!-- Segunda línea: Mesa - número - Precio -->
            <TextView
                android:id="@+id/tvMesas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mesa - m1, m2  -  $150000"
                android:textSize="12sp" />

            <!-- Tercera línea: Hora -->
            <TextView
                android:id="@+id/tvHora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="14:30"
                android:textSize="12sp"
                android:textColor="#666666" />

        </LinearLayout>

        <!-- Detalles (expandible) -->
        <LinearLayout
            android:id="@+id/detallesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Platos del pedido:"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- RecyclerView de detalles -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvSinDetalles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Sin platos registrados"
                android:textAlignment="center"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Botón cambiar estado -->
            <LinearLayout
                android:id="@+id/botonesAccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:visibility="gone"
                android:gravity="center">

                <Button
                    android:id="@+id/btnDividirCuenta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Dividir"
                    android:backgroundTint="#FFFFFF"
                    android:textColor="#F59E0B" />

                <Button
                    android:id="@+id/btnCambiarEstadoPedido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Siguiente estado" />

                <Button
                    android:id="@+id/btnPagarCuenta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Pagar"
                    android:backgroundTint="#F59E0B" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
