<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

    <TextView
            android:id="@+id/tv_mesa_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#F5A623"
            android:layout_marginBottom="16dp"/>

    <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

    <TextView
            android:id="@+id/tv_vacio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No hay productos en este pedido"
            android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detalles"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

    <TextView
            android:id="@+id/tv_total"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="end"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"/>

    <Button
            android:id="@+id/btn_cobrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cobrar y liberar mesa"
            android:backgroundTint="#F5A623"/>

</LinearLayout>