<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:background="#1A1A2E">

    <!-- Logo circular -->
    <LinearLayout
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:gravity="center"
            android:background="@drawable/bg_circle_orange"
            android:layout_marginBottom="16dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DB"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#F59E0B"/>

    </LinearLayout>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doña Bere"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inicia sesión para continuar"
            android:textSize="13sp"
            android:textColor="#888888"
            android:layout_marginBottom="36dp"/>

    <!-- Campo email -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CORREO"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#252540"
            app:boxStrokeColor="#333360"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:startIconDrawable="@drawable/ic_mail"
            app:startIconTint="#666666"
            android:layout_marginBottom="16dp">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:hint="mozo@donabere.com"
                android:inputType="textEmailAddress"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo contraseña -->
    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONTRASEÑA"
            android:textSize="11sp"
            android:textColor="#AAAAAA"
            android:letterSpacing="0.08"
            android:layout_marginBottom="6dp"/>

    <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxBackgroundColor="#252540"
            app:boxStrokeColor="#333360"
            app:boxCornerRadiusTopStart="10dp"
            app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp"
            app:boxCornerRadiusBottomEnd="10dp"
            app:startIconDrawable="@drawable/ic_lock"
            app:startIconTint="#666666"
            app:endIconMode="password_toggle"
            app:endIconTint="#666666"
            android:layout_marginBottom="24dp">
        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContrasena"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textColorHint="#666666"
                android:hint="••••••••"
                android:inputType="textPassword"/>
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón ingresar -->
    <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Ingresar"
            android:textSize="15sp"
            android:textColor="#1A1A2E"
            android:backgroundTint="#F59E0B"
            android:layout_marginBottom="12dp"/>

    <!-- Separador -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
        <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#333333"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="o continúa con" android:textSize="12sp"
                android:textColor="#555555" android:layout_marginHorizontal="10dp"/>
        <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" android:background="#333333"/>
    </LinearLayout>

    <!-- Botón huella -->
    <Button
            android:id="@+id/btnIngresarHuella"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Ingresar con huella"
            android:textSize="14sp"
            android:textColor="#16A34A"
            android:backgroundTint="#252540"
            android:strokeColor="#16A34A"
            android:strokeWidth="1"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

    <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="#F59E0B"
            android:visibility="gone"/>

    <TextView
            android:id="@+id/tvError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E94560"
            android:textSize="13sp"
            android:visibility="gone"/>

</LinearLayout>